# Copy to .env and set DB_PASSWORD for the local MySQL account.
DB_URL="jdbc:mysql://127.0.0.1:3306/bloodconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
SERVER_PORT=8080
SHOW_SQL=false
